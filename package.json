{
  "name": "serve-content",
  "description": "Serve static files based on file name extensions",
  "version": "1.0.9",
  "author": "Emilio Platzer <emilioplatzer@gmail.com>",
  "license": "MIT",
  "repository": "emilioplatzer/serve-content",
  "main": "serve-content.js",
  "types": "serve-content.d.ts",
  "files": [
    "serve-content.js",
    "serve-content.d.ts"
  ],
  "overrides": {
    "diff": ">=8.0.2",
    "serialize-javascript": ">=7.0.0",
    "uuid": ">=14.0.0"
  },
  "dependencies": {
    "parseurl": "^1.3.3",
    "serve-static": "^2.2.1",
    "best-globals": "^2.2.3",
    "mime": "^4.1.1",
    "mime-types": "^3.0.2",
    "mini-tools": "^1.13.14"
  },
  "devDependencies": {
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "qa-control": "^0.14.2",
    "supertest": "^7.3.1",
    "@types/serve-static": "^2.2.0"
  },
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "test": "mocha --reporter spec --bail --check-leaks --globals __core-js_shared__ test/",
    "test-ci": "nyc mocha --exit --check-leaks --globals __core-js_shared__ test/",
    "test-cov": "nyc mocha --exit",
    "start": "node example/server.js"
  },
  "nyc": {
    "extension": [
      ".js"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "include": [
      "serve-content.js"
    ],
    "reporter": [
      "html",
      "lcov",
      "text-summary"
    ],
    "all": true
  },
  "qa-control": {
    "run-in": "server",
    "test-appveyor": true,
    "type": "lib",
    "coverage": 100,
    "gha": "all",
    "sonar": true
  }
}
